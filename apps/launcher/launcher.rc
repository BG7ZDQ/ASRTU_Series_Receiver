#include <windows.h>

IDI_APPLICATION_ICON ICON "../../assets/branding/astro_series_launcher.ico"

#ifndef ASRTU_VERSION_COMMA
#define ASRTU_VERSION_COMMA 1,5,4
#endif
#ifndef ASRTU_VERSION_STRING
#define ASRTU_VERSION_STRING "1.5.4"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ASRTU_VERSION_COMMA
 PRODUCTVERSION ASRTU_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BG7ZDQ"
            VALUE "FileDescription", "ASRTU Series Receiver launcher"
            VALUE "FileVersion", ASRTU_VERSION_STRING
            VALUE "InternalName", "ASRTU1_Launcher.exe"
            VALUE "LegalCopyright", "By BG7ZDQ"
            VALUE "OriginalFilename", "ASRTU1_Launcher.exe"
            VALUE "ProductName", "ASRTU Series Receiver"
            VALUE "ProductVersion", ASRTU_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
